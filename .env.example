# ==============================================================================
# e-BIS Sahayak - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application.
# Do NOT commit real API keys or sensitive credentials to version control.

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="e-BIS Sahayak"
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ebis_sahayak
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ebis_sahayak
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/ebis_sahayak

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=bis_standards_collection

# Groq Cloud LLM Configuration (Phase 3+)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Model Configuration (Phase 2+)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Frontend Configuration (Public)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="e-BIS Sahayak"
NEXT_PUBLIC_PHASE="Phase 1: Foundation"
