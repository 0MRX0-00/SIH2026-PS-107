# ==============================================================================
# e-BIS Sahayak — Production Environment Configuration
# SIH 2026 Problem Statement: SIH26107
# AI-Powered Intelligent Assistant for Indian Standards & BIS Services
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="e-BIS Sahayak"
API_V1_STR="/api/v1"

# LLM Provider Configuration (Groq / OpenAI / Local HuggingFace)
# Primary production LLM provider: Groq with llama-3.3-70b-versatile
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_production_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding Model (SentenceTransformers)
# Default production model: BAAI/bge-small-en-v1.5 (384 dimensions)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# Qdrant Vector Database
# Set QDRANT_LOCATION or QDRANT_URL. For production cluster:
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=bis_knowledge
QDRANT_LOCATION=

# Admin Authentication Secret Key
ADMIN_API_KEY=ebis-admin-secret-key-production-2026

# Multilingual Translation Service (m2m100 or opus-mt / simulated)
TRANSLATION_BACKEND=m2m100

# CORS Allowed Origins (Comma-separated origins for production frontend)
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://ebis-sahayak.gov.in","https://sih.bis.gov.in"]

# Next.js Frontend Public Variables (used by frontend container)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
